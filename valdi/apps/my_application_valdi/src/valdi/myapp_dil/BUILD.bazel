load("//bzl/valdi:valdi_module.bzl", "valdi_module")

# Empty module: the DIL UI is rendered by the real engine (`dil_widgets`), which the Android
# host loads at runtime from assets. Nothing is generated here, so there is no
# `android_class_path` and no `android_deps`.
valdi_module(
    name = "myapp_dil",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
    ]) + [
        "tsconfig.json",
    ],
    android_output_target = "release",
    visibility = ["//visibility:public"],
    deps = [
        "//src/valdi_modules/src/valdi/valdi_core",
        "//src/valdi_modules/src/valdi/valdi_tsx",
    ],
)
